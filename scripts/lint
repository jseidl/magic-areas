#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Lint against the newest Home Assistant version that
# pytest-homeassistant-custom-component supports (see scripts/ha-versions).
# Set HA_STABLE_VERSION to override.
HA_VERSIONS=$(scripts/ha-versions)
eval "$HA_VERSIONS"
export HA_MAJOR_VERSION

tox -e lint
