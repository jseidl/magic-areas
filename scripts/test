#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Which version(s) to run: default = major
CHOICE="${1:-major}"

# Shift the first argument and capture remaining args for pytest
shift 2>/dev/null || true
PYTEST_ARGS=("$@")

# Home Assistant versions to test against, capped at the newest version
# pytest-homeassistant-custom-component supports (see scripts/ha-versions).
# Set HA_STABLE_VERSION, HA_MAJOR_VERSION, HA_PREVIOUS_STABLE_VERSION or
# HA_BETA_VERSION to override.
HA_VERSIONS=$(scripts/ha-versions)
eval "$HA_VERSIONS"

export HA_STABLE_VERSION
export HA_MAJOR_VERSION
export HA_BETA_VERSION
export HA_PREVIOUS_STABLE_VERSION

# Build tox command with optional pytest args
build_tox_cmd() {
  local env=$1
  if [ ${#PYTEST_ARGS[@]} -gt 0 ]; then
    echo "tox -e $env -- ${PYTEST_ARGS[*]}"
  else
    echo "tox -e $env"
  fi
}

case "$CHOICE" in
  stable)
    echo "Running tests against Home Assistant stable: $HA_STABLE_VERSION"
    [ ${#PYTEST_ARGS[@]} -gt 0 ] && echo "Pytest args: ${PYTEST_ARGS[*]}"
    eval "$(build_tox_cmd ha-stable)"
    ;;
  major)
    echo "Running tests against Home Assistant major release: $HA_MAJOR_VERSION"
    [ ${#PYTEST_ARGS[@]} -gt 0 ] && echo "Pytest args: ${PYTEST_ARGS[*]}"
    eval "$(build_tox_cmd ha-major)"
    ;;
  previous-stable)
    echo "Running tests against Home Assistant previous stable: $HA_PREVIOUS_STABLE_VERSION"
    [ ${#PYTEST_ARGS[@]} -gt 0 ] && echo "Pytest args: ${PYTEST_ARGS[*]}"
    eval "$(build_tox_cmd ha-previous-stable)"
    ;;
  beta)
    echo "Running tests against Home Assistant beta: $HA_BETA_VERSION"
    [ ${#PYTEST_ARGS[@]} -gt 0 ] && echo "Pytest args: ${PYTEST_ARGS[*]}"
    eval "$(build_tox_cmd ha-beta)"
    ;;
  both)
    echo "Running tests against both stable ($HA_STABLE_VERSION) and beta ($HA_BETA_VERSION)"
    [ ${#PYTEST_ARGS[@]} -gt 0 ] && echo "Pytest args: ${PYTEST_ARGS[*]}"
    eval "$(build_tox_cmd ha-stable,ha-beta)"
    ;;
  *)
    echo "Usage: $0 [stable|major|previous-stable|beta|both] [pytest-args...]"
    echo ""
    echo "Examples:"
    echo "  $0 stable                              # Run all tests"
    echo "  $0 stable tests/test_wasp_in_a_box.py  # Run specific test file"
    echo "  $0 stable tests/test_presence.py::test_area_state_changes -v  # Run specific test with verbose"
    echo "  $0 stable tests/ -k wasp               # Run tests matching 'wasp'"
    exit 1
    ;;
esac
